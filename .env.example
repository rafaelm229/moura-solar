NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
POSTGRES_HOST_PORT=5433
POSTGRES_DB=moura_solar
POSTGRES_USER=moura
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://moura:change-me-local@localhost:5433/moura_solar?schema=public
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=moura-local
S3_SECRET_KEY=change-me-minio
S3_BUCKET=moura-solar-local
API_INTERNAL_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Gere dois segredos distintos com: openssl rand -hex 32
# Estes valores sao somente exemplos locais. Troque antes de qualquer deploy.
IDENTITY_LINK_SECRET=local-example-link-secret-change-before-deploy
BOOTSTRAP_TOKEN=local-example-bootstrap-token-change-before-deploy
WEB_ORIGIN=http://localhost:3000
# Use true com HTTPS em homologacao/producao.
COOKIE_SECURE=false

# Novos uploads nunca usam fallback local. LEGACY_LOCAL é somente leitura de legado.
S3_BACKEND=MINIO
# Sem scanner disponível, o arquivo fica em quarentena e não pode ser baixado.
CLAMD_HOST=localhost
CLAMD_PORT=3310
