generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  teams       Team[]
  customers   Customer[]
  utilityUnits UtilityUnit[]
  opportunities Opportunity[]
  activities  Activity[]

  @@map("organizations")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  memberships  Membership[]
  opportunities Opportunity[]
  activities   Activity[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         String       @default("invited")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  sessions       Session[]
  links          AccessLink[]
  teams          TeamMember[]

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  version        Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  grants         RoleGrant[]
  memberships    Membership[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  key    String      @id
  grants RoleGrant[]

  @@map("permissions")
}

model RoleGrant {
  roleId     String     @map("role_id") @db.Uuid
  permission String
  scope      String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability Permission @relation(fields: [permission], references: [key])

  @@id([roleId, permission])
  @@map("role_grants")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  version        Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId       String     @map("team_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@id([teamId, membershipId])
  @@map("team_members")
}

model Session {
  id              String         @id @default(uuid()) @db.Uuid
  membershipId    String         @map("membership_id") @db.Uuid
  accessHash      String         @unique @map("access_hash")
  accessExpiresAt DateTime       @map("access_expires_at")
  expiresAt       DateTime       @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  device          String
  createdAt       DateTime       @default(now()) @map("created_at")
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at")
  membership      Membership     @relation(fields: [membershipId], references: [id])
  refreshTokens   RefreshToken[]

  @@index([membershipId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  hash      String    @id
  sessionId String    @map("session_id") @db.Uuid
  usedAt    DateTime? @map("used_at")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@map("refresh_tokens")
}

model AccessLink {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  hash         String     @unique
  kind         String
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@index([membershipId, kind])
  @@map("access_links")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityId       String?  @map("entity_id")
  traceId        String   @map("trace_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model IdentityCommand {
  key         String   @id
  actorId     String   @map("actor_id") @db.Uuid
  fingerprint String
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("identity_commands")
}

model LoginThrottle {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime @map("reset_at")

  @@map("login_throttles")
}

model Customer {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  kind              String            @default("PERSON")
  legalName         String            @map("legal_name")
  tradeName         String?           @map("trade_name")
  taxId             String?           @map("tax_id")
  stateRegistration String?           @map("state_registration")
  notes             String?
  status            String            @default("ACTIVE")
  version           Int               @default(1)
  archivedAt        DateTime?         @map("archived_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  contacts          CustomerContact[]
  addresses         Address[]
  utilityUnits      UtilityUnit[]
  opportunities     Opportunity[]
  activities        Activity[]

  @@index([organizationId, status])
  @@index([organizationId, taxId])
  @@map("customers")
}

model CustomerContact {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  type            String   // PHONE, EMAIL, WHATSAPP, OTHER
  value           String
  normalizedValue String   @map("normalized_value")
  label           String?
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@index([normalizedValue])
  @@map("customer_contacts")
}

model Address {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String?       @map("customer_id") @db.Uuid
  postalCode   String        @map("postal_code")
  street       String
  number       String
  complement   String?
  district     String?
  city         String
  state        String
  country      String        @default("BR")
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  isPrimary    Boolean       @default(false) @map("is_primary")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  utilityUnits UtilityUnit[]

  @@index([customerId])
  @@map("addresses")
}

model UtilityUnit {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  addressId       String?       @map("address_id") @db.Uuid
  distributorName String        @map("distributor_name")
  externalCode    String?       @map("external_code")
  consumerClass   String        @default("RESIDENTIAL") @map("consumer_class")
  tariffMode      String        @default("CONVENTIONAL") @map("tariff_mode")
  connectionType  String        @default("BIPHASIC") @map("connection_type")
  voltage         String        @default("220V")
  status          String        @default("ACTIVE")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization    Organization  @relation(fields: [organizationId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  address         Address?      @relation(fields: [addressId], references: [id])
  opportunities   Opportunity[]

  @@index([organizationId, externalCode])
  @@index([customerId])
  @@map("utility_units")
}

model Opportunity {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  customerId           String                  @map("customer_id") @db.Uuid
  utilityUnitId        String?                 @map("utility_unit_id") @db.Uuid
  code                 String
  title                String
  ownerUserId          String                  @map("owner_user_id") @db.Uuid
  source               String                  @default("INBOUND")
  projectType          String                  @default("ON_GRID") @map("project_type")
  needSummary          String                  @map("need_summary")
  estimatedConsumption Decimal?                @map("estimated_consumption") @db.Decimal(10, 2)
  priority             String                  @default("WARM")
  state                String                  @default("NOVO")
  expectedCloseDate    DateTime?               @map("expected_close_date") @db.Date
  lossReason           String?                 @map("loss_reason")
  lossNotes            String?                 @map("loss_notes")
  lostAt               DateTime?               @map("lost_at")
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id])
  customer             Customer                @relation(fields: [customerId], references: [id])
  utilityUnit          UtilityUnit?            @relation(fields: [utilityUnitId], references: [id])
  owner                User                    @relation(fields: [ownerUserId], references: [id])
  activities           Activity[]
  transitions          OpportunityTransition[]

  @@unique([organizationId, code])
  @@index([organizationId, state])
  @@index([organizationId, ownerUserId])
  @@index([customerId])
  @@map("opportunities")
}

model OpportunityTransition {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  fromState     String      @map("from_state")
  toState       String      @map("to_state")
  command       String
  actorId       String      @map("actor_id") @db.Uuid
  justification String?
  createdAt     DateTime    @default(now()) @map("created_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("opportunity_transitions")
}

model Activity {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  opportunityId      String?      @map("opportunity_id") @db.Uuid
  customerId         String?      @map("customer_id") @db.Uuid
  type               String       // CALL, MESSAGE, MEETING, VISIT, EMAIL, TASK
  subject            String
  description        String?
  assigneeUserId     String       @map("assignee_user_id") @db.Uuid
  dueAt              DateTime     @map("due_at")
  status             String       @default("OPEN") // OPEN, COMPLETED, CANCELED
  resultCode         String?      @map("result_code")
  resultNotes        String?      @map("result_notes")
  completedAt        DateTime?    @map("completed_at")
  previousActivityId String?      @map("previous_activity_id") @db.Uuid
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id])
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer           Customer?    @relation(fields: [customerId], references: [id])
  assignee           User         @relation(fields: [assigneeUserId], references: [id])

  @@index([organizationId, assigneeUserId, status, dueAt])
  @@index([opportunityId])
  @@map("activities")
}
