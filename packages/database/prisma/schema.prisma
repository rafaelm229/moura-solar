generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  teams       Team[]
  customers   Customer[]
  utilityUnits UtilityUnit[]
  opportunities Opportunity[]
  activities  Activity[]
  energyReadings EnergyReading[]
  surveys     Survey[]
  catalogItems CatalogItem[]
  designs     Design[]
  designVersions DesignVersion[]
  designItems DesignItem[]
  additionalCosts AdditionalCost[]
  pricingCalculations PricingCalculation[]
  proposals   Proposal[]
  proposalVersions ProposalVersion[]
  proposalDocuments ProposalDocument[]
  proposalDeliveries ProposalDelivery[]
  proposalAcceptances ProposalAcceptance[]

  @@map("organizations")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  memberships  Membership[]
  opportunities Opportunity[]
  activities   Activity[]
  completedSurveys Survey[] @relation("CompletedSurveys")
  approvedDesignVersions DesignVersion[] @relation("ApprovedDesignVersions")
  createdProposalVersions ProposalVersion[] @relation("CreatedProposalVersions")
  sentProposalDeliveries ProposalDelivery[] @relation("SentProposalDeliveries")
  recordedProposalAcceptances ProposalAcceptance[] @relation("RecordedProposalAcceptances")

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         String       @default("invited")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  sessions       Session[]
  links          AccessLink[]
  teams          TeamMember[]

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  version        Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  grants         RoleGrant[]
  memberships    Membership[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  key    String      @id
  grants RoleGrant[]

  @@map("permissions")
}

model RoleGrant {
  roleId     String     @map("role_id") @db.Uuid
  permission String
  scope      String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability Permission @relation(fields: [permission], references: [key])

  @@id([roleId, permission])
  @@map("role_grants")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  version        Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId       String     @map("team_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@id([teamId, membershipId])
  @@map("team_members")
}

model Session {
  id              String         @id @default(uuid()) @db.Uuid
  membershipId    String         @map("membership_id") @db.Uuid
  accessHash      String         @unique @map("access_hash")
  accessExpiresAt DateTime       @map("access_expires_at")
  expiresAt       DateTime       @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  device          String
  createdAt       DateTime       @default(now()) @map("created_at")
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at")
  membership      Membership     @relation(fields: [membershipId], references: [id])
  refreshTokens   RefreshToken[]

  @@index([membershipId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  hash      String    @id
  sessionId String    @map("session_id") @db.Uuid
  usedAt    DateTime? @map("used_at")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@map("refresh_tokens")
}

model AccessLink {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  hash         String     @unique
  kind         String
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@index([membershipId, kind])
  @@map("access_links")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityId       String?  @map("entity_id")
  traceId        String   @map("trace_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model IdentityCommand {
  key         String   @id
  actorId     String   @map("actor_id") @db.Uuid
  fingerprint String
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("identity_commands")
}

model LoginThrottle {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime @map("reset_at")

  @@map("login_throttles")
}

model Customer {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  kind              String            @default("PERSON")
  legalName         String            @map("legal_name")
  tradeName         String?           @map("trade_name")
  taxId             String?           @map("tax_id")
  stateRegistration String?           @map("state_registration")
  notes             String?
  status            String            @default("ACTIVE")
  version           Int               @default(1)
  archivedAt        DateTime?         @map("archived_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  contacts          CustomerContact[]
  addresses         Address[]
  utilityUnits      UtilityUnit[]
  opportunities     Opportunity[]
  activities        Activity[]

  @@index([organizationId, status])
  @@index([organizationId, taxId])
  @@map("customers")
}

model CustomerContact {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  type            String   // PHONE, EMAIL, WHATSAPP, OTHER
  value           String
  normalizedValue String   @map("normalized_value")
  label           String?
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@index([normalizedValue])
  @@map("customer_contacts")
}

model Address {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String?       @map("customer_id") @db.Uuid
  postalCode   String        @map("postal_code")
  street       String
  number       String
  complement   String?
  district     String?
  city         String
  state        String
  country      String        @default("BR")
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  isPrimary    Boolean       @default(false) @map("is_primary")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  utilityUnits UtilityUnit[]

  @@index([customerId])
  @@map("addresses")
}

model UtilityUnit {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  addressId       String?       @map("address_id") @db.Uuid
  distributorName String        @map("distributor_name")
  externalCode    String?       @map("external_code")
  consumerClass   String        @default("RESIDENTIAL") @map("consumer_class")
  tariffMode      String        @default("CONVENTIONAL") @map("tariff_mode")
  connectionType  String        @default("BIPHASIC") @map("connection_type")
  voltage         String        @default("220V")
  status          String        @default("ACTIVE")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization    Organization  @relation(fields: [organizationId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  address         Address?      @relation(fields: [addressId], references: [id])
  opportunities   Opportunity[]
  energyReadings  EnergyReading[]
  surveys         Survey[]

  @@index([organizationId, externalCode])
  @@index([customerId])
  @@map("utility_units")
}

model Opportunity {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  customerId           String                  @map("customer_id") @db.Uuid
  utilityUnitId        String?                 @map("utility_unit_id") @db.Uuid
  code                 String
  title                String
  ownerUserId          String                  @map("owner_user_id") @db.Uuid
  source               String                  @default("INBOUND")
  projectType          String                  @default("ON_GRID") @map("project_type")
  needSummary          String                  @map("need_summary")
  estimatedConsumption Decimal?                @map("estimated_consumption") @db.Decimal(10, 2)
  priority             String                  @default("WARM")
  state                String                  @default("NOVO")
  expectedCloseDate    DateTime?               @map("expected_close_date") @db.Date
  lossReason           String?                 @map("loss_reason")
  lossNotes            String?                 @map("loss_notes")
  lostAt               DateTime?               @map("lost_at")
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id])
  customer             Customer                @relation(fields: [customerId], references: [id])
  utilityUnit          UtilityUnit?            @relation(fields: [utilityUnitId], references: [id])
  owner                User                    @relation(fields: [ownerUserId], references: [id])
  activities           Activity[]
  transitions          OpportunityTransition[]
  surveys              Survey[]
  designs              Design[]
  proposals            Proposal[]

  @@unique([organizationId, code])
  @@index([organizationId, state])
  @@index([organizationId, ownerUserId])
  @@index([customerId])
  @@map("opportunities")
}

model OpportunityTransition {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  fromState     String      @map("from_state")
  toState       String      @map("to_state")
  command       String
  actorId       String      @map("actor_id") @db.Uuid
  justification String?
  createdAt     DateTime    @default(now()) @map("created_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("opportunity_transitions")
}

model Activity {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  opportunityId      String?      @map("opportunity_id") @db.Uuid
  customerId         String?      @map("customer_id") @db.Uuid
  type               String       // CALL, MESSAGE, MEETING, VISIT, EMAIL, TASK
  subject            String
  description        String?
  assigneeUserId     String       @map("assignee_user_id") @db.Uuid
  dueAt              DateTime     @map("due_at")
  status             String       @default("OPEN") // OPEN, COMPLETED, CANCELED
  resultCode         String?      @map("result_code")
  resultNotes        String?      @map("result_notes")
  completedAt        DateTime?    @map("completed_at")
  previousActivityId String?      @map("previous_activity_id") @db.Uuid
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id])
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer           Customer?    @relation(fields: [customerId], references: [id])
  assignee           User         @relation(fields: [assigneeUserId], references: [id])

  @@index([organizationId, assigneeUserId, status, dueAt])
  @@index([opportunityId])
  @@map("activities")
}

model EnergyReading {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  utilityUnitId  String       @map("utility_unit_id") @db.Uuid
  referenceMonth String       @map("reference_month")
  consumptionKwh Decimal      @map("consumption_kwh") @db.Decimal(10, 2)
  injectedKwh    Decimal?     @map("injected_kwh") @db.Decimal(10, 2)
  billedAmount   Decimal?     @map("billed_amount") @db.Decimal(12, 2)
  source         String       @default("MANUAL")
  status         String       @default("ACTIVE")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  utilityUnit    UtilityUnit  @relation(fields: [utilityUnitId], references: [id], onDelete: Cascade)

  @@unique([utilityUnitId, referenceMonth])
  @@index([utilityUnitId])
  @@map("energy_readings")
}

model Survey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  opportunityId  String       @map("opportunity_id") @db.Uuid
  utilityUnitId  String?      @map("utility_unit_id") @db.Uuid
  type           String       @default("REMOTE")
  status         String       @default("DRAFT")
  tariffPerKwh   Decimal      @default(0.95) @map("tariff_per_kwh") @db.Decimal(10, 4)
  connectionType String       @default("BIPHASIC") @map("connection_type")
  voltage        String       @default("220V")
  roofType       String?      @map("roof_type")
  shadingKnown   Boolean      @default(false) @map("shading_known")
  notes          String?
  assumptions    Json?
  completedById  String?      @map("completed_by_id") @db.Uuid
  completedAt    DateTime?    @map("completed_at")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  utilityUnit    UtilityUnit? @relation(fields: [utilityUnitId], references: [id])
  completedBy    User?        @relation("CompletedSurveys", fields: [completedById], references: [id])

  @@index([opportunityId])
  @@map("surveys")
}

model CatalogItem {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  sku                 String
  kind                String
  category            String
  name                String
  manufacturer        String?
  model               String?
  unitOfMeasure       String        @default("UN") @map("unit_of_measure")
  powerRatingWp       Decimal?      @map("power_rating_wp") @db.Decimal(10, 2)
  powerRatingKw       Decimal?      @map("power_rating_kw") @db.Decimal(10, 2)
  technicalAttributes Json?         @map("technical_attributes")
  referenceCost       Decimal       @map("reference_cost") @db.Decimal(12, 2)
  referencePrice      Decimal?      @map("reference_price") @db.Decimal(12, 2)
  status              String        @default("ACTIVE")
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  organization        Organization  @relation(fields: [organizationId], references: [id])
  designItems         DesignItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, category, status])
  @@map("catalog_items")
}

model Design {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  opportunityId  String          @map("opportunity_id") @db.Uuid
  name           String          @default("Dimensionamento Padrão")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  opportunity    Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  versions       DesignVersion[]

  @@index([opportunityId])
  @@map("designs")
}

model DesignVersion {
  id                            String               @id @default(uuid()) @db.Uuid
  organizationId                String               @map("organization_id") @db.Uuid
  designId                      String               @map("design_id") @db.Uuid
  versionNumber                 Int                  @map("version_number")
  basedOnVersionId              String?              @map("based_on_version_id") @db.Uuid
  status                        String               @default("DRAFT")
  systemType                    String               @default("ON_GRID") @map("system_type")
  targetMonthlyGenerationKwh    Decimal              @map("target_monthly_generation_kwh") @db.Decimal(12, 2)
  targetConsumptionKwh          Decimal              @map("target_consumption_kwh") @db.Decimal(12, 2)
  dcPowerKwp                    Decimal              @map("dc_power_kwp") @db.Decimal(10, 3)
  acPowerKw                     Decimal              @map("ac_power_kw") @db.Decimal(10, 3)
  estimatedMonthlyGenerationKwh Decimal              @map("estimated_monthly_generation_kwh") @db.Decimal(12, 2)
  estimatedAnnualGenerationKwh  Decimal              @map("estimated_annual_generation_kwh") @db.Decimal(12, 2)
  specificYield                 Decimal              @default(135.00) @map("specific_yield") @db.Decimal(10, 2)
  calculationVersion            String               @default("v1.0-simplified") @map("calculation_version")
  assumptionsSnapshot           Json                 @map("assumptions_snapshot")
  approvedById                  String?              @map("approved_by_id") @db.Uuid
  approvedAt                    DateTime?            @map("approved_at")
  justification                 String?
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     DateTime             @updatedAt @map("updated_at")

  organization                  Organization         @relation(fields: [organizationId], references: [id])
  design                        Design               @relation(fields: [designId], references: [id], onDelete: Cascade)
  approvedBy                    User?                @relation("ApprovedDesignVersions", fields: [approvedById], references: [id])
  items                         DesignItem[]
  additionalCosts               AdditionalCost[]
  pricing                       PricingCalculation?
  proposalVersions              ProposalVersion[]

  @@unique([designId, versionNumber])
  @@index([designId, status])
  @@map("design_versions")
}

model DesignItem {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  designVersionId String        @map("design_version_id") @db.Uuid
  catalogItemId   String?       @map("catalog_item_id") @db.Uuid
  kind            String
  category        String
  description     String
  unitOfMeasure   String        @map("unit_of_measure")
  quantity        Decimal       @db.Decimal(10, 2)
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 2)
  totalCost       Decimal       @map("total_cost") @db.Decimal(12, 2)
  costSource      String        @default("CATALOG") @map("cost_source")
  isOptional      Boolean       @default(false) @map("is_optional")
  justification   String?
  createdAt       DateTime      @default(now()) @map("created_at")

  organization    Organization  @relation(fields: [organizationId], references: [id])
  designVersion   DesignVersion @relation(fields: [designVersionId], references: [id], onDelete: Cascade)
  catalogItem     CatalogItem?  @relation(fields: [catalogItemId], references: [id])

  @@index([designVersionId])
  @@map("design_items")
}

model AdditionalCost {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  designVersionId     String        @map("design_version_id") @db.Uuid
  category            String
  description         String
  amount              Decimal       @db.Decimal(12, 2)
  commercialTreatment String        @default("INCLUDED_IN_PRICE") @map("commercial_treatment")
  justification       String?
  createdAt           DateTime      @default(now()) @map("created_at")

  organization        Organization  @relation(fields: [organizationId], references: [id])
  designVersion       DesignVersion @relation(fields: [designVersionId], references: [id], onDelete: Cascade)

  @@index([designVersionId])
  @@map("additional_costs")
}

model PricingCalculation {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  designVersionId     String        @unique @map("design_version_id") @db.Uuid
  directMaterialCost  Decimal       @map("direct_material_cost") @db.Decimal(12, 2)
  directServiceCost   Decimal       @map("direct_service_cost") @db.Decimal(12, 2)
  additionalCost      Decimal       @map("additional_cost") @db.Decimal(12, 2)
  contingencyAmount   Decimal       @default(0) @map("contingency_amount") @db.Decimal(12, 2)
  totalEstimatedCost  Decimal       @map("total_estimated_cost") @db.Decimal(12, 2)
  markupPercent       Decimal       @map("markup_percent") @db.Decimal(6, 2)
  priceBeforeDiscount Decimal       @map("price_before_discount") @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalPrice          Decimal       @map("final_price") @db.Decimal(12, 2)
  grossMarginAmount   Decimal       @map("gross_margin_amount") @db.Decimal(12, 2)
  grossMarginPercent  Decimal       @map("gross_margin_percent") @db.Decimal(6, 2)
  status              String        @default("DRAFT")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  organization        Organization  @relation(fields: [organizationId], references: [id])
  designVersion       DesignVersion @relation(fields: [designVersionId], references: [id], onDelete: Cascade)

  @@map("pricing_calculations")
}

model Proposal {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  opportunityId     String            @map("opportunity_id") @db.Uuid
  code              String
  acceptedVersionId String?           @map("accepted_version_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  opportunity       Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  versions          ProposalVersion[]

  @@unique([organizationId, code])
  @@index([opportunityId])
  @@map("proposals")
}

model ProposalVersion {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  proposalId           String               @map("proposal_id") @db.Uuid
  versionNumber        Int                  @map("version_number")
  designVersionId      String               @map("design_version_id") @db.Uuid
  basedOnVersionId     String?              @map("based_on_version_id") @db.Uuid
  status               String               @default("DRAFT") // DRAFT, READY, SENT, VIEWED, ACCEPTED, REJECTED, EXPIRED, SUPERSEDED, CANCELED
  customerSnapshot     Json                 @map("customer_snapshot")
  utilityUnitSnapshot  Json                 @map("utility_unit_snapshot")
  technicalSnapshot    Json                 @map("technical_snapshot")
  commercialSnapshot   Json                 @map("commercial_snapshot")
  validityDays         Int                  @default(10) @map("validity_days")
  validUntil           DateTime?            @map("valid_until")
  currency             String               @default("BRL")
  finalPrice           Decimal              @map("final_price") @db.Decimal(12, 2)
  paymentConditions    Json?                @map("payment_conditions")
  observations         String?
  contentHash          String               @map("content_hash")
  version              Int                  @default(1)
  createdById          String?              @map("created_by_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  organization         Organization         @relation(fields: [organizationId], references: [id])
  proposal             Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  designVersion        DesignVersion        @relation(fields: [designVersionId], references: [id])
  createdBy            User?                @relation("CreatedProposalVersions", fields: [createdById], references: [id])
  documents            ProposalDocument[]
  deliveries           ProposalDelivery[]
  acceptance           ProposalAcceptance?

  @@unique([proposalId, versionNumber])
  @@index([proposalId, status])
  @@map("proposal_versions")
}

model ProposalDocument {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  proposalVersionId String          @map("proposal_version_id") @db.Uuid
  type              String          @default("PDF_PROPOSAL")
  fileName          String          @map("file_name")
  fileSize          Int             @map("file_size")
  mimeType          String          @default("application/pdf") @map("mime_type")
  s3Bucket          String          @map("s3_bucket")
  s3Key             String          @map("s3_key")
  contentHash       String          @map("content_hash")
  generationStatus  String          @default("READY") @map("generation_status")
  generatedAt       DateTime        @default(now()) @map("generated_at")

  organization      Organization    @relation(fields: [organizationId], references: [id])
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@index([proposalVersionId])
  @@map("proposal_documents")
}

model ProposalDelivery {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  proposalVersionId String          @map("proposal_version_id") @db.Uuid
  channel           String          // WHATSAPP, EMAIL, DOWNLOAD, IN_PERSON, MANUAL
  recipient         String?
  status            String          @default("SENT")
  sentById          String          @map("sent_by_id") @db.Uuid
  sentAt            DateTime        @default(now()) @map("sent_at")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")

  organization      Organization    @relation(fields: [organizationId], references: [id])
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  sentBy            User            @relation("SentProposalDeliveries", fields: [sentById], references: [id])

  @@index([proposalVersionId])
  @@map("proposal_deliveries")
}

model ProposalAcceptance {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  proposalVersionId String          @unique @map("proposal_version_id") @db.Uuid
  method            String          // SIGNED_DOCUMENT, MESSAGE, IN_PERSON, E_SIGNATURE
  acceptedByName    String          @map("accepted_by_name")
  acceptedAt        DateTime        @default(now()) @map("accepted_at")
  recordedById      String          @map("recorded_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")

  organization      Organization    @relation(fields: [organizationId], references: [id])
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  recordedBy        User            @relation("RecordedProposalAcceptances", fields: [recordedById], references: [id])

  @@map("proposal_acceptances")
}

