generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  teams       Team[]
  customers   Customer[]
  utilityUnits UtilityUnit[]
  opportunities Opportunity[]
  activities  Activity[]
  energyReadings EnergyReading[]
  energyBillImports EnergyBillImport[]
  energyImportOutbox ImportOutbox[]
  importReviews ImportReview[]
  importApplications ImportApplication[]
  energyReadingRevisions EnergyReadingRevision[]
  energyImportTransitions EnergyImportTransition[]
  extractionAttempts ExtractionAttempt[]
  surveys     Survey[]
  catalogItems CatalogItem[]
  designs     Design[]
  designVersions DesignVersion[]
  designItems DesignItem[]
  additionalCosts AdditionalCost[]
  pricingCalculations PricingCalculation[]
  proposals   Proposal[]
  proposalVersions ProposalVersion[]
  proposalDocuments ProposalDocument[]
  proposalDeliveries ProposalDelivery[]
  proposalAcceptances ProposalAcceptance[]
  contracts           Contract[]
  contractVersions    ContractVersion[]
  contractDocuments   ContractDocument[]
  contractDeliveries  ContractDelivery[]
  signedReviews       SignedContractReview[]
  projectGates        ProjectGate[]
  financialAccounts   FinancialAccount[]
  paymentPlans        PaymentPlan[]
  receivables         Receivable[]
  receipts            Receipt[]
  receiptAllocations  ReceiptAllocation[]
  payables            Payable[]
  payments            Payment[]
  paymentAllocations  PaymentAllocation[]
  commissions         Commission[]
  cashMovements       CashMovement[]
  stockLocations      StockLocation[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  stockReservationItems StockReservationItem[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceipts       GoodsReceipt[]
  goodsReceiptItems   GoodsReceiptItem[]
  serializedAssets    SerializedAsset[]
  operationalProjects OperationalProject[]
  executiveDesigns    ExecutiveDesign[]
  homologationProcesses HomologationProcess[]
  workOrders          WorkOrder[]
  workOrderChecklistItems WorkOrderChecklistItem[]
  customerHandovers   CustomerHandover[]
  supportTickets      SupportTicket[]
  supportInteractions SupportInteraction[]
  warrantyCoverages   WarrantyCoverage[]
  warrantyClaims      WarrantyClaim[]
  serviceVisitQuotes  ServiceVisitQuote[]
  monitoringSystems   MonitoringSystem[]
  monitoringReadings  MonitoringReading[]
  connectivityIncidents ConnectivityIncident[]
  automationRuleVersions AutomationRuleVersion[]
  automationExecutions   AutomationExecution[]
  attentionItems         AttentionItem[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  goalVersions           GoalVersion[]
  metricProjections      MetricProjection[]
  dossierDocuments       DossierDocument[]
  storedObjects          StoredObject[]
  customerRepresentatives CustomerRepresentative[]
  documentAccessEvents   DocumentAccessEvent[]

  @@map("organizations")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  memberships  Membership[]
  opportunities Opportunity[]
  activities   Activity[]
  completedSurveys Survey[] @relation("CompletedSurveys")
  approvedDesignVersions DesignVersion[] @relation("ApprovedDesignVersions")
  createdProposalVersions ProposalVersion[] @relation("CreatedProposalVersions")
  sentProposalDeliveries ProposalDelivery[] @relation("SentProposalDeliveries")
  recordedProposalAcceptances ProposalAcceptance[] @relation("RecordedProposalAcceptances")
  createdContractVersions ContractVersion[] @relation("CreatedContractVersions")
  sentContractDeliveries ContractDelivery[] @relation("SentContractDeliveries")
  reviewedSignedContracts SignedContractReview[] @relation("ReviewedSignedContracts")
  satisfiedProjectGates ProjectGate[] @relation("SatisfiedProjectGates")
  createdReceipts       Receipt[]     @relation("CreatedReceipts")
  createdPayments       Payment[]     @relation("CreatedPayments")
  managedStockLocations     StockLocation[]      @relation("ManagedStockLocations")
  createdStockMovements     StockMovement[]      @relation("CreatedStockMovements")
  createdStockReservations  StockReservation[]   @relation("CreatedStockReservations")
  createdPurchaseOrders     PurchaseOrder[]      @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders    PurchaseOrder[]      @relation("ApprovedPurchaseOrders")
  receivedGoodsReceipts     GoodsReceipt[]       @relation("ReceivedGoodsReceipts")
  engineeredProjects        OperationalProject[] @relation("EngineeredProjects")
  approvedExecutiveDesigns  ExecutiveDesign[]    @relation("ApprovedExecutiveDesigns")
  ledWorkOrders             WorkOrder[]          @relation("LedWorkOrders")
  checkedWorkOrderItems     WorkOrderChecklistItem[] @relation("CheckedWorkOrderItems")
  receivedHandovers         CustomerHandover[]   @relation("ReceivedHandovers")
  assignedSupportTickets    SupportTicket[]      @relation("AssignedSupportTickets")
  supportInteractions       SupportInteraction[] @relation("AuthorSupportInteractions")
  validatedMonitoringReadings MonitoringReading[] @relation("ValidatedMonitoringReadings")
  assignedAttentionItems AttentionItem[] @relation("AssignedAttentionItems")
  resolvedAttentionItems AttentionItem[] @relation("ResolvedAttentionItems")
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  energyImportTransitions EnergyImportTransition[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         String       @default("invited")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  sessions       Session[]
  links          AccessLink[]
  teams          TeamMember[]

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  version        Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  grants         RoleGrant[]
  memberships    Membership[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  key    String      @id
  grants RoleGrant[]

  @@map("permissions")
}

model RoleGrant {
  roleId     String     @map("role_id") @db.Uuid
  permission String
  scope      String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability Permission @relation(fields: [permission], references: [key])

  @@id([roleId, permission])
  @@map("role_grants")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  version        Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]
  workOrders     WorkOrder[]
  assignedSupportTickets SupportTicket[]
  attentionItems AttentionItem[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId       String     @map("team_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@id([teamId, membershipId])
  @@map("team_members")
}

model Session {
  id              String         @id @default(uuid()) @db.Uuid
  membershipId    String         @map("membership_id") @db.Uuid
  accessHash      String         @unique @map("access_hash")
  accessExpiresAt DateTime       @map("access_expires_at")
  expiresAt       DateTime       @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  device          String
  createdAt       DateTime       @default(now()) @map("created_at")
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at")
  membership      Membership     @relation(fields: [membershipId], references: [id])
  refreshTokens   RefreshToken[]

  @@index([membershipId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  hash      String    @id
  sessionId String    @map("session_id") @db.Uuid
  usedAt    DateTime? @map("used_at")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@map("refresh_tokens")
}

model AccessLink {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  hash         String     @unique
  kind         String
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@index([membershipId, kind])
  @@map("access_links")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityId       String?  @map("entity_id")
  traceId        String   @map("trace_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model IdentityCommand {
  key         String   @id
  actorId     String   @map("actor_id") @db.Uuid
  fingerprint String
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("identity_commands")
}

model LoginThrottle {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime @map("reset_at")

  @@map("login_throttles")
}

model Customer {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  kind              String            @default("PERSON")
  legalName         String            @map("legal_name")
  tradeName         String?           @map("trade_name")
  taxId             String?           @map("tax_id")
  stateRegistration String?           @map("state_registration")
  notes             String?
  status            String            @default("ACTIVE")
  version           Int               @default(1)
  archivedAt        DateTime?         @map("archived_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  contacts          CustomerContact[]
  addresses         Address[]
  utilityUnits      UtilityUnit[]
  energyBillImports EnergyBillImport[]
  opportunities     Opportunity[]
  activities        Activity[]
  supportTickets    SupportTicket[]
  dossierDocuments  DossierDocument[]
  customerRepresentatives CustomerRepresentative[]

  @@index([organizationId, status])
  @@index([organizationId, taxId])
  @@map("customers")
}

model CustomerContact {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  type            String   // PHONE, EMAIL, WHATSAPP, OTHER
  value           String
  normalizedValue String   @map("normalized_value")
  label           String?
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@index([normalizedValue])
  @@map("customer_contacts")
}

model Address {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String?       @map("customer_id") @db.Uuid
  postalCode   String        @map("postal_code")
  street       String
  number       String
  complement   String?
  district     String?
  city         String
  state        String
  country      String        @default("BR")
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  isPrimary    Boolean       @default(false) @map("is_primary")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  utilityUnits UtilityUnit[]

  @@index([customerId])
  @@map("addresses")
}

model UtilityUnit {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  addressId       String?       @map("address_id") @db.Uuid
  distributorName String        @map("distributor_name")
  externalCode    String?       @map("external_code")
  consumerClass   String        @default("RESIDENTIAL") @map("consumer_class")
  tariffMode      String        @default("CONVENTIONAL") @map("tariff_mode")
  connectionType  String        @default("BIPHASIC") @map("connection_type")
  voltage         String        @default("220V")
  status          String        @default("ACTIVE")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization    Organization  @relation(fields: [organizationId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  address         Address?      @relation(fields: [addressId], references: [id])
  opportunities   Opportunity[]
  energyReadings  EnergyReading[]
  energyBillImports EnergyBillImport[]
  energyReadingRevisions EnergyReadingRevision[]
  surveys         Survey[]
  documentLinks   DocumentUtilityUnitLink[]

  @@index([organizationId, externalCode])
  @@index([customerId])
  @@map("utility_units")
}

model Opportunity {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  customerId           String                  @map("customer_id") @db.Uuid
  utilityUnitId        String?                 @map("utility_unit_id") @db.Uuid
  code                 String
  title                String
  ownerUserId          String                  @map("owner_user_id") @db.Uuid
  source               String                  @default("INBOUND")
  projectType          String                  @default("ON_GRID") @map("project_type")
  needSummary          String                  @map("need_summary")
  estimatedConsumption Decimal?                @map("estimated_consumption") @db.Decimal(10, 2)
  priority             String                  @default("WARM")
  state                String                  @default("NOVO")
  expectedCloseDate    DateTime?               @map("expected_close_date") @db.Date
  lossReason           String?                 @map("loss_reason")
  lossNotes            String?                 @map("loss_notes")
  lostAt               DateTime?               @map("lost_at")
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id])
  customer             Customer                @relation(fields: [customerId], references: [id])
  utilityUnit          UtilityUnit?            @relation(fields: [utilityUnitId], references: [id])
  owner                User                    @relation(fields: [ownerUserId], references: [id])
  activities           Activity[]
  transitions          OpportunityTransition[]
  surveys              Survey[]
  designs              Design[]
  proposals            Proposal[]
  contracts            Contract[]
  projectGates         ProjectGate[]
  paymentPlans         PaymentPlan[]
  receivables          Receivable[]
  receipts             Receipt[]
  payables             Payable[]
  commissions          Commission[]
  stockMovements       StockMovement[]
  stockReservation     StockReservation?
  purchaseOrders       PurchaseOrder[]
  serializedAssets     SerializedAsset[]
  operationalProject   OperationalProject?
  dossierLinks         DocumentOpportunityLink[]
  energyBillImports    EnergyBillImport[]

  @@unique([organizationId, code])
  @@index([organizationId, state])
  @@index([organizationId, ownerUserId])
  @@index([customerId])
  @@map("opportunities")
}

model OpportunityTransition {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  fromState     String      @map("from_state")
  toState       String      @map("to_state")
  command       String
  actorId       String      @map("actor_id") @db.Uuid
  justification String?
  createdAt     DateTime    @default(now()) @map("created_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("opportunity_transitions")
}

model Activity {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  opportunityId      String?      @map("opportunity_id") @db.Uuid
  customerId         String?      @map("customer_id") @db.Uuid
  type               String       // CALL, MESSAGE, MEETING, VISIT, EMAIL, TASK
  subject            String
  description        String?
  assigneeUserId     String       @map("assignee_user_id") @db.Uuid
  dueAt              DateTime     @map("due_at")
  status             String       @default("OPEN") // OPEN, COMPLETED, CANCELED
  resultCode         String?      @map("result_code")
  resultNotes        String?      @map("result_notes")
  completedAt        DateTime?    @map("completed_at")
  previousActivityId String?      @map("previous_activity_id") @db.Uuid
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id])
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer           Customer?    @relation(fields: [customerId], references: [id])
  assignee           User         @relation(fields: [assigneeUserId], references: [id])

  @@index([organizationId, assigneeUserId, status, dueAt])
  @@index([opportunityId])
  @@map("activities")
}

model EnergyReading {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  utilityUnitId  String       @map("utility_unit_id") @db.Uuid
  referenceMonth String       @map("reference_month")
  consumptionKwh Decimal      @map("consumption_kwh") @db.Decimal(10, 2)
  injectedKwh    Decimal?     @map("injected_kwh") @db.Decimal(10, 2)
  billedAmount   Decimal?     @map("billed_amount") @db.Decimal(12, 2)
  source         String       @default("MANUAL")
  status         String       @default("ACTIVE")
  version        Int          @default(1)
  correctionReason String?     @map("correction_reason")
  sourceImportId String?       @map("source_import_id") @db.Uuid
  sourceReviewId String?        @map("source_review_id") @db.Uuid
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  utilityUnit    UtilityUnit  @relation(fields: [utilityUnitId], references: [id], onDelete: Cascade)
  sourceImport   EnergyBillImport? @relation("ImportReadings", fields: [sourceImportId], references: [id], onDelete: Restrict)
  sourceReview   ImportReview? @relation("ReviewReadings", fields: [sourceReviewId], references: [id], onDelete: Restrict)
  revisions      EnergyReadingRevision[]

  @@unique([utilityUnitId, referenceMonth, version])
  @@index([utilityUnitId, status, referenceMonth])
  @@map("energy_readings")
}

model EnergyBillImport {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  customerId          String                  @map("customer_id") @db.Uuid
  utilityUnitId       String?                 @map("utility_unit_id") @db.Uuid
  opportunityId       String?                 @map("opportunity_id") @db.Uuid
  documentVersionId   String                  @unique @map("document_version_id") @db.Uuid
  status              String                  @default("QUEUED")
  version             Int                     @default(1)
  createdById         String                  @map("created_by_id") @db.Uuid
  cancellationRequestedAt DateTime?            @map("cancellation_requested_at")
  appliedAt           DateTime?                @map("applied_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id])
  customer            Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  utilityUnit         UtilityUnit?              @relation(fields: [utilityUnitId], references: [id], onDelete: Restrict)
  opportunity         Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  documentVersion     DossierDocumentVersion   @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  outboxEvents        ImportOutbox[]
  transitions         EnergyImportTransition[]
  extractionAttempts ExtractionAttempt[]
  candidates          ExtractionCandidate[]
  reviews             ImportReview[]
  application         ImportApplication?
  appliedReadings     EnergyReading[]          @relation("ImportReadings")
  revisions           EnergyReadingRevision[]

  @@index([organizationId, customerId, createdAt])
  @@index([status, updatedAt])
  @@map("energy_bill_imports")
}

model ImportOutbox {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  importId       String          @map("import_id") @db.Uuid
  eventType      String          @map("event_type")
  dedupeKey      String          @unique @map("dedupe_key")
  payload        Json
  status         String          @default("PENDING")
  attempts       Int             @default(0)
  availableAt    DateTime        @default(now()) @map("available_at")
  leaseUntil     DateTime?       @map("lease_until")
  leaseOwner     String?         @map("lease_owner")
  heartbeatAt    DateTime?       @map("heartbeat_at")
  completedAt    DateTime?       @map("completed_at")
  lastErrorCode  String?         @map("last_error_code")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  energyBillImport EnergyBillImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  extractionAttempt ExtractionAttempt?

  @@index([status, availableAt])
  @@index([importId])
  @@map("import_outbox")
}

model EnergyImportTransition {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  importId       String          @map("import_id") @db.Uuid
  actorId        String          @map("actor_id") @db.Uuid
  action         String
  fromStatus     String          @map("from_status")
  toStatus       String          @map("to_status")
  version        Int
  reason         String
  createdAt      DateTime        @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  energyBillImport EnergyBillImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  actor          User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([importId, version])
  @@index([organizationId, createdAt])
  @@map("energy_import_transitions")
}

model ExtractionAttempt {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  importId            String          @map("import_id") @db.Uuid
  outboxId            String?         @unique @map("outbox_id") @db.Uuid
  attemptNumber       Int             @map("attempt_number")
  correlationId       String          @unique @map("correlation_id")
  adapterName         String?         @map("adapter_name")
  modelName           String?         @map("model_name")
  modelVersion        String?         @map("model_version")
  externalOperationId String?         @map("external_operation_id")
  status              String          @default("CLAIMED")
  leaseOwner          String?         @map("lease_owner")
  leaseUntil          DateTime?       @map("lease_until")
  heartbeatAt         DateTime?       @map("heartbeat_at")
  startedAt           DateTime        @default(now()) @map("started_at")
  finishedAt          DateTime?       @map("finished_at")
  pageCount           Int?            @map("page_count")
  chargedPages        Int?            @map("charged_pages")
  estimatedCost       Decimal?        @map("estimated_cost") @db.Decimal(12, 6)
  actualCost          Decimal?        @map("actual_cost") @db.Decimal(12, 6)
  currency            String?
  errorCode           String?         @map("error_code")
  retryable           Boolean?
  nextAttemptAt       DateTime?       @map("next_attempt_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  organization        Organization    @relation(fields: [organizationId], references: [id])
  energyBillImport    EnergyBillImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  outbox              ImportOutbox?   @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  candidates          ExtractionCandidate[]

  @@unique([importId, attemptNumber])
  @@index([organizationId, startedAt])
  @@index([status, leaseUntil])
  @@map("extraction_attempts")
}

model ExtractionCandidate {
  id                 String          @id @default(uuid()) @db.Uuid
  importId           String          @map("import_id") @db.Uuid
  attemptId          String?         @map("attempt_id") @db.Uuid
  source             String          @default("MANUAL")
  field              String
  rawValue           String?         @map("raw_value")
