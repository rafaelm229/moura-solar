  organizationId   String       @map("organization_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  category         String       // COMMERCIAL, OPERATIONAL, FINANCIAL, SYSTEM
  channel          String       @default("INTERNAL") // INTERNAL, EMAIL
  enabled          Boolean      @default(true)
  quietHoursStart  String?      @map("quiet_hours_start")
  quietHoursEnd    String?      @map("quiet_hours_end")
  timezone         String       @default("America/Sao_Paulo")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id])
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, category, channel])
  @@map("notification_preferences")
}

model GoalVersion {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  metricKey      String       @map("metric_key") // SALES_VALUE, PROPOSALS_ACCEPTED, INSTALLATIONS_COUNT, SUPPORT_SLA_PERCENT, MARGIN_PERCENT
  name           String
  scopeType      String       @default("ORGANIZATION") @map("scope_type") // ORGANIZATION, TEAM, USER
  scopeId        String?      @map("scope_id")
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  targetValue    Decimal      @map("target_value") @db.Decimal(14, 2)
  currentValue   Decimal      @default(0) @map("current_value") @db.Decimal(14, 2)
  unit           String       @default("BRL") // BRL, COUNT, PERCENT, KWH
  version        Int          @default(1)
  status         String       @default("ACTIVE") // ACTIVE, ARCHIVED
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, metricKey, status])
  @@map("goal_versions")
}

model MetricProjection {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  metricKey      String       @map("metric_key")
  period         String       // YYYY-MM
  dimensions     Json         @default("{}")
  value          Decimal      @db.Decimal(14, 2)
  calculatedAt   DateTime     @default(now()) @map("calculated_at")
  revision       Int          @default(1)

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, metricKey, period])
  @@index([period])
  @@map("metric_projections")
}

// ==========================================
// SPEC-013: Dossiê Documental Permanente e Armazenamento Durável
// ==========================================

model DossierDocument {
  id             String                        @id @default(uuid()) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  customerId     String                        @map("customer_id") @db.Uuid
  category       String
  title          String
  status         String                        @default("ACTIVE") // ACTIVE, ARCHIVED
  purpose        String?
  metadataVersion Int                          @default(1) @map("metadata_version")
  archiveReason  String?                       @map("archive_reason")
  createdBy      String                        @map("created_by")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  organization        Organization              @relation(fields: [organizationId], references: [id])
  customer            Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  versions            DossierDocumentVersion[]
  utilityUnitLinks    DocumentUtilityUnitLink[]
  opportunityLinks    DocumentOpportunityLink[]
  projectLinks        DocumentProjectLink[]
  representativeLinks DocumentRepresentativeLink[]
  contractLinks       DocumentContractLink[]
  workOrderLinks      DocumentWorkOrderLink[]

  @@index([organizationId, customerId])
  @@index([category, status])
  @@map("dossier_documents")
}

model DossierDocumentVersion {
  id               String          @id @default(uuid()) @db.Uuid
  documentId       String          @map("document_id") @db.Uuid
  versionNumber    Int             @map("version_number")
  originalName     String          @map("original_name")
  fileSize         Int             @map("file_size")
  declaredMime     String          @map("declared_mime")
  verifiedMime     String?         @map("verified_mime")
  sha256           String
  persistenceState String          @default("PENDING_UPLOAD") @map("persistence_state") // PENDING_UPLOAD, READY, FAILED
  storedObjectId   String?         @map("stored_object_id") @db.Uuid
  authorId         String          @map("author_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  document         DossierDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  storedObject     StoredObject?   @relation(fields: [storedObjectId], references: [id])
  energyBillImport EnergyBillImport?
  energyReadingRevisions EnergyReadingRevision[]

  @@unique([documentId, versionNumber])
  @@index([sha256])
  @@map("dossier_document_versions")
}

model StoredObject {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  backend        String                   @default("MINIO") // MINIO, S3, LEGACY_LOCAL
  bucket         String
  key            String
  sha256         String
  byteSize       Int                      @map("byte_size")
  verified       Boolean                  @default(false)
  scannerVersion String?                  @map("scanner_version")
  scanResult     String?                  @map("scan_result") // CLEAN, SUSPICIOUS, UNCHECKED
  createdAt      DateTime                 @default(now()) @map("created_at")

  organization     Organization            @relation(fields: [organizationId], references: [id])
  documentVersions DossierDocumentVersion[]

  @@unique([bucket, key])
  @@index([organizationId, sha256])
  @@map("stored_objects")
}

model CustomerRepresentative {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  customerId     String                       @map("customer_id") @db.Uuid
  name           String
  documentNumber String?                      @map("document_number")
  role           String                       @default("LEGAL_REPRESENTATIVE") // LEGAL_REPRESENTATIVE, ATTORNEY, TECHNICAL_RESPONSIBLE, FINANCIAL_CONTACT, OTHER
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  organization   Organization                 @relation(fields: [organizationId], references: [id])
  customer       Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  documentLinks  DocumentRepresentativeLink[]

  @@index([organizationId, customerId])
  @@map("customer_representatives")
}

model DocumentRepresentativeLink {
  id               String                 @id @default(uuid()) @db.Uuid
  documentId       String                 @map("document_id") @db.Uuid
  representativeId String                 @map("representative_id") @db.Uuid

  document         DossierDocument        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  representative   CustomerRepresentative @relation(fields: [representativeId], references: [id], onDelete: Restrict)

  @@unique([documentId, representativeId])
  @@map("document_representative_links")
}

model DocumentUtilityUnitLink {
  id            String          @id @default(uuid()) @db.Uuid
  documentId    String          @map("document_id") @db.Uuid
  utilityUnitId String          @map("utility_unit_id") @db.Uuid

  document      DossierDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  utilityUnit   UtilityUnit     @relation(fields: [utilityUnitId], references: [id], onDelete: Restrict)

  @@unique([documentId, utilityUnitId])
  @@map("document_utility_unit_links")
}

model DocumentOpportunityLink {
  id            String          @id @default(uuid()) @db.Uuid
  documentId    String          @map("document_id") @db.Uuid
  opportunityId String          @map("opportunity_id") @db.Uuid

  document      DossierDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  @@unique([documentId, opportunityId])
  @@map("document_opportunity_links")
}

model DocumentProjectLink {
  id         String             @id @default(uuid()) @db.Uuid
  documentId String             @map("document_id") @db.Uuid
  projectId  String             @map("project_id") @db.Uuid

  document   DossierDocument    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  project    OperationalProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([documentId, projectId])
  @@map("document_project_links")
}

model DocumentWorkOrderLink {
  id          String          @id @default(uuid()) @db.Uuid
  documentId  String          @map("document_id") @db.Uuid
  workOrderId String          @map("work_order_id") @db.Uuid
  phase       String?

  document    DossierDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@unique([documentId, workOrderId])
  @@map("document_work_order_links")
}

model DocumentContractLink {
  id         String          @id @default(uuid()) @db.Uuid
  documentId String          @map("document_id") @db.Uuid
  contractId String          @map("contract_id") @db.Uuid

  document   DossierDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([documentId, contractId])
  @@map("document_contract_links")
}

model DocumentAccessEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String       @map("actor_id")
  targetType     String       @map("target_type") // DOSSIER, PROPOSAL, CONTRACT
  targetId       String       @map("target_id")
  versionId      String?      @map("version_id")
  purpose        String       @default("VIEW") // VIEW, DOWNLOAD
  outcome        String       @default("SUCCESS") // SUCCESS, DENIED, ERROR
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  occurredAt     DateTime     @default(now()) @map("occurred_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, targetId])
  @@index([actorId, occurredAt])
  @@map("document_access_events")
}




model DossierCommand {
  key            String   @id
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  fingerprint    String
  result         Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("dossier_commands")
}
