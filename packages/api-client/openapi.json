  "info": {
    "title": "Moura Solar API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ms_access"
      }
    },
    "schemas": {
      "BootstrapDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "name": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          }
        },
        "required": ["email", "password", "name", "organization"]
      },
      "CommandResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": ["id"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "GrantDto": {
        "type": "object",
        "properties": {
          "permission": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["own", "team", "organization", "assigned", "linked", "domain"]
          }
        },
        "required": ["permission", "scope"]
      },
      "ContextDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "roleName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "number"
          },
          "organizationId": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantDto"
            }
          },
          "teamIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "roleId",
          "roleName",
          "status",
          "version",
          "organizationId",
          "organizationName",
          "sessionId",
          "grants",
          "teamIds"
        ]
      },
      "AcceptLinkDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": ["token", "password"]
      },
      "SessionViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string"
          }
        },
        "required": ["id", "device", "current", "createdAt", "lastSeenAt"]
      },
      "MemberViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "roleName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "number"
          }
        },
        "required": ["id", "name", "email", "roleId", "roleName", "status", "version"]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          }
        },
        "required": ["email", "name", "roleId"]
      },
      "LinkResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": ["id", "token", "expiresAt"]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "roleId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "blocked"]
          }
        },
        "required": ["version", "roleId", "status"]
      },
      "RoleViewDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantDto"
            }
          },
          "version": {
            "type": "number"
          },
          "id": {
            "type": "string"
          }
        },
        "required": ["name", "grants", "id"]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantDto"
            }
          },
          "version": {
            "type": "number"
          }
        },
        "required": ["name", "grants"]
      },
      "CandidateDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "TeamViewDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "number"
          },
          "id": {
            "type": "string"
          }
        },
        "required": ["name", "memberIds", "id"]
      },
      "TeamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
